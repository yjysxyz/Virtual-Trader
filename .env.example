# 本地 SQLite 数据库文件（相对路径按项目目录计算）。
# 复制本文件为 .env 后按需修改；首次启动会自动建表。
SQLITE_PATH=market_sim.db

# 邮件验证码（Resend）
RESEND_API_KEY=
MAIL_FROM=清醒投资 <no-reply@virtualtrader123.xyz>
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
EMAIL_CODE_SECRET=请替换为随机字符串
# 本地没有 API Key 时可设为 1：验证码只打印在终端，并自动填入页面
EMAIL_DRY_RUN=0
